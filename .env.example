# Filled in automatically by `shopify app config link` / `shopify app dev`
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_discounts,read_discounts,read_orders
SHOPIFY_APP_URL=

# Postgres connection string, e.g. from Neon or Fly Postgres
DATABASE_URL=

# Gmail account used to send affiliate notification emails.
# GMAIL_APP_PASSWORD is a Google "App Password", not the account's login password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
