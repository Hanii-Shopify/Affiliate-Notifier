# Filled in automatically by `shopify app config link` / `shopify app dev`
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_discounts,read_discounts,read_orders
SHOPIFY_APP_URL=

# Postgres connection string, e.g. from Neon or Fly Postgres
DATABASE_URL=

# Gmail sender (address + app password) is configured from the app's
# own Settings page and stored in the database. GMAIL_USER/
# GMAIL_APP_PASSWORD env vars are only used as a fallback on a fresh
# install before anyone has visited that page — set them here only if
# you want sending to work immediately without opening the app first.
